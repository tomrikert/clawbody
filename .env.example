# ClawBody Configuration
# Give your OpenClaw AI agent a physical robot body!

# ==============================================================================
# AI Provider
# ==============================================================================
# openai = OpenAI Realtime API for STT + LLM + TTS
# local = faster-whisper STT + Ollama LLM + Kokoro TTS
AI_PROVIDER=openai

# ==============================================================================
# REQUIRED when AI_PROVIDER=openai: OpenAI API Key
# ==============================================================================
# Get your key at: https://platform.openai.com/api-keys
# Requires Realtime API access
OPENAI_API_KEY=sk-your-openai-key

# ==============================================================================
# REQUIRED: OpenClaw Gateway
# ==============================================================================
# The URL where your OpenClaw gateway is running
# If running on the same machine as the robot, use the host machine's IP
OPENCLAW_GATEWAY_URL=http://localhost:18789

# Your OpenClaw gateway authentication token
# Find this in ~/.openclaw/openclaw.json under gateway.token
OPENCLAW_TOKEN=your-gateway-token

# Agent ID to use (default: main)
OPENCLAW_AGENT_ID=main

# Session key for conversation context - IMPORTANT!
# Use "main" (default) to share context with WhatsApp and other DM channels
# This allows the robot to be aware of all your conversations
OPENCLAW_SESSION_KEY=main

# ==============================================================================
# OPTIONAL: Voice Settings
# ==============================================================================
# OpenAI Realtime voice (alloy, echo, fable, onyx, nova, shimmer, cedar)
OPENAI_VOICE=cedar

# OpenAI model for Realtime API
OPENAI_MODEL=gpt-4o-realtime-preview-2024-12-17

# ==============================================================================
# OPTIONAL: Local AI Settings (AI_PROVIDER=local)
# ==============================================================================
# Recommended for an RTX 5090 Laptop GPU: gemma4 for live voice, qwen3.6 for slower reasoning.
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434
LOCAL_LLM_MODEL=gemma4:latest
LOCAL_LLM_THINK=false

# Local speech-to-text via faster-whisper
LOCAL_STT_MODEL=large-v3-turbo
LOCAL_STT_DEVICE=cpu
LOCAL_STT_COMPUTE_TYPE=int8
# For CUDA STT, install the cuda12-stt extra and run scripts/clawbody-local-cuda12.
# That launcher sets LOCAL_STT_DEVICE=cuda and LOCAL_STT_COMPUTE_TYPE=float16.

# Local text-to-speech via Kokoro
LOCAL_TTS_ENGINE=kokoro
LOCAL_TTS_LANG=a
LOCAL_TTS_VOICE=af_heart
LOCAL_TTS_SPEED=1.0

# Local voice activity detection tuning
LOCAL_VAD_THRESHOLD=0.015
LOCAL_VAD_SILENCE_MS=700
LOCAL_MIN_SPEECH_MS=250

# Local camera descriptions use Ollama in local mode
LOCAL_VISION_LLM_MODEL=gemma4:latest

# ==============================================================================
# OPTIONAL: Features
# ==============================================================================
# Enable/disable features (true/false)
ENABLE_CAMERA=true
ENABLE_OPENCLAW_TOOLS=true
